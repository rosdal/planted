# Copy to .env and fill in for local development.
# Never commit real secrets; .env is gitignored.
NODE_ENV=development
DATABASE_URL=postgres://planted:planted@localhost:5433/planted
SERVER_PORT=3000
SERVER_HOST=0.0.0.0
WEB_ORIGIN=http://localhost:5173
VITE_API_URL=http://localhost:3000
# Maps and icons: the R2 custom domain in production, `pnpm content:serve` locally.
VITE_CONTENT_URL=http://localhost:5174
LOG_LEVEL=debug
# Signs room tokens; at least 32 random bytes as base64url. Generate one with:
#   node -e "console.log(crypto.randomBytes(32).toString('base64url'))"
ROOM_TOKEN_SECRET=
# Set to true behind a reverse proxy, so rate limits see client addresses.
TRUST_PROXY=false
TEST_DATABASE_URL=postgres://planted:planted@localhost:5433/planted_test
