{
  "name": "planted",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm db:up && pnpm db:migrate && turbo dev",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "test": "vitest run",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "pnpm lint && pnpm content:check && turbo typecheck build && tsc -p e2e && pnpm test",
    "e2e": "playwright test",
    "db:up": "docker compose -f docker-compose.dev.yml up -d --wait",
    "db:down": "docker compose -f docker-compose.dev.yml down",
    "db:reset": "docker compose -f docker-compose.dev.yml down -v && pnpm db:up",
    "db:generate": "pnpm --filter @planted/db db:generate",
    "db:migrate": "pnpm --filter @planted/db db:migrate",
    "db:studio": "pnpm --filter @planted/db db:studio",
    "bots": "pnpm --filter @planted/scripts bots",
    "content:extract": "pnpm --filter @planted/content content:extract",
    "content:check": "pnpm --filter @planted/content content:check",
    "content:build": "pnpm --filter @planted/content content:build",
    "content:serve": "pnpm --filter @planted/content content:serve",
    "prepare": "lefthook install"
  },
  "packageManager": "pnpm@12.15.0+sha512.b3951d6d6ff4a9f13dc7cf56cd28d2b8eb37dbcc9c68e52e1e1191873ea9f82a017287ab50baadc5ccc494f036c67c0e47eb13608c2fa36f47711b61ea128e61",
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@playwright/test": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "lefthook": "^2.2.2",
    "turbo": "^2.11.10",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
